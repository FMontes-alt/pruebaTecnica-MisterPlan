<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    
    <!-- Fuentes Google: Plus Jakarta Sans (Tipografía moderna) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Hoja de estilos del sistema de diseño -->
    <link rel="stylesheet" href="/assets/css/style.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Encabezado con efecto Glassmorphism y navegación corporativa -->
    <header class="app-header">
        <div class="container header-container">
            <a href="/" class="brand-logo" aria-label="MisterPlan Reservas">
                <div class="brand-symbol">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </div>
                <div class="brand-text-group">
                    <span class="brand-title">Mister<span class="brand-accent">Plan</span></span>
                    <span class="brand-subtitle">PMS &bull; Gestión Hotelera</span>
                </div>
            </a>

            <!-- Estado del sistema y accesos directos -->
            <div class="header-right">
                <div class="system-status-pill">
                    <span class="status-dot"></span>
                    <span class="status-text">Motor Online</span>
                </div>
                <nav class="nav-links">
                    <a href="/" class="nav-link active">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Reservas</span>
                    </a>
                    <a href="/api/reservas" target="_blank" class="nav-link api-badge" title="Explorar endpoint de la API REST">
                        <span>API REST</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="7" y1="17" x2="17" y2="7"></line>
                            <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                    </a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Contenedor flotante para notificaciones Toast -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <!-- Contenido principal inyectado por las vistas -->
    <main class="main-content">
        <div class="container">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- Pie de página corporativo -->
    <footer class="app-footer">
        <div class="container footer-content">
            <div class="footer-left">
                <p>&copy; {{ current_year }} <strong>MisterPlan</strong> &bull; Software turístico y motor de reservas líder en España.</p>
                <p class="footer-sub">Arquitectura limpia en PHP 8.2 nativo &bull; Motor de plantillas Twig &bull; JavaScript Vanilla &bull; MySQL</p>
            </div>
            <div class="footer-badges">
                <span class="tech-tag">PHP 8.2</span>
                <span class="tech-tag">Twig 3</span>
                <span class="tech-tag">MySQL PDO</span>
                <span class="tech-tag">PHPUnit 10</span>
            </div>
        </div>
    </footer>

    <!-- Scripts globales -->
    <script src="/assets/js/api.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>