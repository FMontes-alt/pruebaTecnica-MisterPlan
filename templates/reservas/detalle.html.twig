{% extends "base.html.twig" %}

{% block title %}Reserva #{{ reserva.id }} — {{ reserva.nombre_huesped }} — {{ app_name }}{% endblock %}

{% block content %}
<div class="detail-page-wrapper">
    <!-- Barra superior de navegación / Migas de pan -->
    <nav class="breadcrumb-nav" aria-label="Navegación">
        <a href="/" class="btn-breadcrumb">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Volver al listado de reservas</span>
        </a>
    </nav>

    <!-- Cabecera principal de la ficha -->
    <header class="detail-hero-header">
        <div class="detail-hero-info">
            <div class="detail-status-bar">
                <span class="id-badge-lg">#{{ reserva.id }}</span>
                <span class="status-pill pill-{{ reserva.estado }} pill-lg" id="detalle-badge-estado">
                    <span class="pill-dot"></span>
                    {{ reserva.estado|capitalize }}
                </span>
            </div>
            <h1 class="detail-main-title">{{ reserva.nombre_alojamiento }}</h1>
            <p class="detail-sub-meta">
                Huésped titular: <strong>{{ reserva.nombre_huesped }}</strong> &bull; Registrada el {{ reserva.fecha_creacion|date('d/m/Y H:i') }}
            </p>
        </div>

        <!-- Acciones sobre la reserva -->
        <div class="detail-actions-panel" id="detalle-action-container">
            {% if reserva.estado == 'pendiente' %}
                <button type="button" class="btn btn-success shadow-glow" id="btn-confirmar-reserva" data-id="{{ reserva.id }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span class="btn-text">Confirmar Reserva</span>
                    <span class="btn-spinner" style="display: none;">⏳ Procesando...</span>
                </button>
            {% endif %}

            {% if reserva.estado != 'cancelada' %}
                <button type="button" class="btn btn-danger-soft" id="btn-cancelar-detalle" data-id="{{ reserva.id }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                    <span>Cancelar Reserva</span>
                </button>
            {% endif %}
        </div>
    </header>

    <!-- Cuadrícula responsive de 2 columnas -->
    <div class="detail-content-grid">
        <!-- Columna Izquierda: Ficha de Datos -->
        <div class="detail-main-col">
            <!-- Tarjeta 1: Huésped y Alojamiento -->
            <div class="card detail-info-card">
                <div class="card-header-styled">
                    <div class="card-icon-pill">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <h2 class="card-title-styled">Información del Huésped</h2>
                </div>

                <div class="info-data-list">
                    <div class="info-row">
                        <span class="info-label">Nombre Titular</span>
                        <span class="info-val strong-val">{{ reserva.nombre_huesped }}</span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Email de Contacto</span>
                        <span class="info-val">
                            <a href="mailto:{{ reserva.email_huesped }}" class="contact-link">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                                <span>{{ reserva.email_huesped }}</span>
                            </a>
                        </span>
                    </div>

                    <div class="info-row">
                        <span class="info-label">Alojamiento</span>
                        <span class="info-val">
                            <span class="hotel-chip">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                {{ reserva.nombre_alojamiento }}
                            </span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Fechas e Importe -->
            <div class="card detail-info-card">
                <div class="card-header-styled">
                    <div class="card-icon-pill">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <h2 class="card-title-styled">Estancia y Facturación</h2>
                </div>

                <div class="dates-banner-grid">
                    <div class="date-box">
                        <span class="date-box-label">Fecha Entrada (Check-in)</span>
                        <span class="date-box-val">{{ reserva.fecha_entrada|date('d/m/Y') }}</span>
                    </div>
                    <div class="date-arrow-circle">→</div>
                    <div class="date-box">
                        <span class="date-box-label">Fecha Salida (Check-out)</span>
                        <span class="date-box-val">{{ reserva.fecha_salida|date('d/m/Y') }}</span>
                    </div>
                </div>

                <div class="price-banner">
                    <div class="price-banner-text">
                        <span class="price-banner-label">Importe Total de la Estancia</span>
                        <span class="price-banner-sub">Tarifa calculada (impuestos incluidos)</span>
                    </div>
                    <div class="price-banner-amount">
                        {{ reserva.importe|number_format(2, ',', '.') }} €
                    </div>
                </div>

                <!-- Observaciones -->
                <div class="notes-wrapper">
                    <span class="notes-header">Observaciones y Notas Especiales:</span>
                    <div class="notes-content">
                        {% if reserva.notas %}
                            <p>{{ reserva.notas|nl2br }}</p>
                        {% else %}
                            <p class="notes-empty">Sin observaciones adicionales para esta reserva.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Historial y Auditoría (Timeline) -->
        <div class="detail-side-col">
            <div class="card timeline-card">
                <div class="card-header-styled">
                    <div class="card-icon-pill pill-purple">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="12 8 12 12 14 14"></polyline>
                            <path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="card-title-styled">Historial de Auditoría</h2>
                        <span class="card-subtitle-styled">Trazabilidad y registro de transacciones</span>
                    </div>
                </div>

                <div class="timeline" id="eventos-timeline">
                    {% for evento in eventos %}
                        <div class="timeline-item timeline-{{ evento.tipo|lower }}">
                            <div class="timeline-marker">
                                {% if evento.tipo == 'CREACION' %}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                {% elseif evento.tipo == 'CONFIRMACION' %}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                {% else %}
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="18" y1="6" x2="6" y2="18"></line>
                                        <line x1="6" y1="6" x2="18" y2="18"></line>
                                    </svg>
                                {% endif %}
                            </div>

                            <div class="timeline-box">
                                <div class="timeline-meta-row">
                                    <span class="timeline-badge badge-{{ evento.tipo|lower }}">
                                        {{ evento.tipo }}
                                    </span>
                                    <time class="timeline-timestamp">
                                        {{ evento.fecha_creacion|date('d/m/Y H:i:s') }}
                                    </time>
                                </div>
                                <p class="timeline-body">
                                    {{ evento.descripcion }}
                                </p>
                            </div>
                        </div>
                    {% else %}
                        <p class="empty-state">No hay eventos registrados para esta reserva.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cancelación en Detalle -->
<div id="modal-cancelar-detalle" class="modal-overlay" style="display: none;" role="dialog" aria-modal="true">
    <div class="modal-card modal-sm">
        <div class="modal-header">
            <div class="modal-title-group">
                <div class="modal-icon-badge badge-danger-soft">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                </div>
                <div>
                    <h2 class="modal-title text-danger">Cancelar Reserva #{{ reserva.id }}</h2>
                    <p class="modal-subtitle">Esta acción registrará un evento de cancelación en el historial.</p>
                </div>
            </div>
            <button type="button" class="btn-modal-close" id="btn-cerrar-cancel-detalle">&times;</button>
        </div>
        <div class="modal-body">
            <p class="cancel-confirm-text">
                ¿Confirmas que deseas cancelar definitivamente esta reserva de <strong>{{ reserva.nombre_huesped }}</strong>?
            </p>
            <div class="form-group" style="margin-top: 1rem;">
                <label for="cancel-motivo-detalle">Motivo de la cancelación (opcional):</label>
                <input type="text" id="cancel-motivo-detalle" class="form-control" placeholder="Petición del cliente, cancelación de viaje...">
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="btn-abort-cancel-detalle">Volver</button>
            <button type="button" class="btn btn-danger" id="btn-confirm-cancel-detalle" data-id="{{ reserva.id }}">
                <span class="btn-text">Confirmar Cancelación</span>
                <span class="btn-spinner" style="display: none;">⏳ Procesando...</span>
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="/assets/js/detalle.js"></script>
{% endblock %}
